#!/bin/zsh

check_site() {
  if_homeovr
  wp_or_drupal "$homeovr/$projectsDirectory"

  if [[ -z $framework ]]; then

    if [[ -z $directory ]]; then
      what_project
    fi

    wp_or_drupal "$homeovr/$projectsDirectory"
  fi
}

##
# Deploy state for the Claude Code status line.
#
# Inside a Claude session the deploy's output only arrives when the command
# ends, so a long promote looks the same as a hung one. This file is the
# live view instead: ~/.claude/statusline.sh reads it and shows the step,
# the phase, how long it has been in it, and a heart that keeps beating while
# Pantheon keeps confirming the work is moving. It is removed on any exit.
#
# "beat" is the last time something CONFIRMED progress — a Pantheon poll
# that answered, a workflow still reported running, a line of drush output —
# never just the clock. That's what lets a stale beat mean "go look".
##
zmodload zsh/datetime
deploy_state_dir=${XDG_CACHE_HOME:-$HOME/.cache}/launcher/deploys
deploy_state_file=

deploy_state_write () {
  [[ -n $deploy_state_file ]] || return 0
  local tmp="$deploy_state_file.tmp.$1"
  print -r -- "pid=$$
site=$site
idx=$ds_idx
count=$count
env=$ds_env
phase=$ds_phase
since=$ds_since
beat=$ds_beat" > "$tmp" && mv -f "$tmp" "$deploy_state_file"
}

# A new phase: resets the phase clock and counts as a beat.
deploy_phase () {
  ds_idx=$1 ds_env=$2 ds_phase=${3%% \(*}
  ds_since=$EPOCHSECONDS ds_beat=$EPOCHSECONDS
  deploy_state_write main
}

deploy_beat () {
  ds_beat=$EPOCHSECONDS
  deploy_state_write ${1:-main}
}

##
# Run a blocking command and keep beating while it is provably working.
#
# workflow: poll Pantheon every 15s and beat only while a workflow is still
#           in flight — for env:deploy, which prints nothing until it's done.
# output:   beat on every line the command prints — for drush deploy, which
#           runs over SSH where no workflow exists to ask about. stderr is
#           folded in because that is where drush logs its progress.
##
with_pulse () {
  local mode=$1 rc pulse
  shift

  if [[ $mode == workflow ]]; then
    {
      local st
      while sleep 15; do
        st=$($terminus workflow:list $site --fields=status --format=tsv 2>/dev/null \
          | awk '/running|queued|started/ { print; exit }')
        [[ -n $st ]] && deploy_beat pulse
      done
    } &
    pulse=$!
    "$@"
    rc=$?
    kill $pulse 2>/dev/null
    wait $pulse 2>/dev/null
    return $rc
  fi

  "$@" 2>&1 | while IFS= read -r line; do
    print -r -- "$line"
    deploy_beat
  done
  return ${pipestatus[1]}
}

##
# Progress line naming the environment and the step.
#
# The old output was "Not yet ready, attempting again in 24 seconds." with no
# indication of which of the three environments it referred to, which step of
# the chain it was on, or what it was waiting for. On a dev->test->live run
# that is the same sentence up to a dozen times, and it is the only thing on
# screen for several minutes.
##
step_say () {
  deploy_phase "$1" "$2" "$3"
  echo
  echo "── [$1/$count] $2 — $3"
  echo
}

step_ok () {
  echo
  echo "✓  [$1/$count] $2 — $3"
  echo
}

step_fail () {
  echo
  echo "✖  [$1/$count] $2 — $3"
  echo
}

terminus_loop () {
  local idx=$1
  local env=$2
  local multi=$3

  # ⚠ Only the environment a push lands on needs a pre-wait: dev, or a
  # multidev, whose branch is pushed straight to it. It is waiting on the
  # build that `git push` kicked off, which is asynchronous. For test and live
  # the code arrives via `env:deploy` BELOW, and that call is synchronous —
  # terminus blocks and draws its own progress bar — so waiting beforehand
  # watches a workflow belonging to the PREVIOUS environment and tells us
  # nothing about this one.
  #
  # ⚠ Multidevs used to skip it. Seen on sisal, 2026-10-08: run straight after
  # a push to the guide branch, drush deploy ran while "Sync code on guide"
  # was still building, imported nothing, and reported success on the old code.
  if [[ $idx -eq 1 ]]; then
    terminus_commit_check "$env" "$idx" || return 1
    terminus_sync_check "$env" "$idx" || return 1
  fi

  # ⚠ The framework was only ever detected inside the dev sync check above,
  # which a multidev skips — so a multidev run matched neither branch below
  # and returned 0 having done nothing. Detect it here for every path, and
  # refuse to report success when it still can't be told.
  [[ -z $framework ]] && check_site
  if [[ $framework != 'drupal' && $framework != 'wordpress' ]]; then
    step_fail "$idx" "$env" "couldn't tell whether this is Drupal or WordPress — stopping, nothing deployed"
    return 1
  fi

  if [[ $framework == 'drupal' ]]; then
    if [[ $env != 'dev' && $multi != true ]]; then
      step_say "$idx" "$env" "promoting code"
      if ! with_pulse workflow $terminus env:deploy "$site.$env"; then
        step_fail "$idx" "$env" "env:deploy failed — stopping, nothing goes further"
        return 1
      fi
    fi

    step_say "$idx" "$env" "drush deploy (updb → cim → cache rebuild → deploy hooks)"

    # ⚠ THE guard. Without checking this status a failed cim on test still
    # promoted the same code to live — and a config import failing on test is
    # precisely the signal saying do not put this on live. The loop used to
    # discard it and carry on.
    if ! with_pulse output $terminus drush "$site.$env" -- deploy -y; then
      step_fail "$idx" "$env" "drush deploy FAILED — stopping before anything reaches the next environment"
      return 1
    fi

    step_ok "$idx" "$env" "done"
  fi

  if [[ $framework == 'wordpress' ]]; then
    if [[ $env != 'dev' && $multi != true ]]; then
      step_say "$idx" "$env" "promoting code"
      if ! with_pulse workflow $terminus env:deploy "$site.$env"; then
        step_fail "$idx" "$env" "env:deploy failed — stopping"
        return 1
      fi
    fi

    # WordPress's answer to drush deploy: database updates for core, and for
    # WooCommerce when it's active. Both are no-ops when nothing is pending.
    wp_step "$idx" "$env" "core database update" core update-db || return 1
    if $terminus wp "$site.$env" -- plugin is-active woocommerce >/dev/null 2>&1; then
      wp_step "$idx" "$env" "WooCommerce database update" wc update || return 1
    fi

    # Nothing else clears caches on a WordPress deploy (drush deploy does it on
    # Drupal): flush the object cache so updated options and schema are read
    # fresh, then Pantheon's edge so visitors get pages built on the new code.
    wp_step "$idx" "$env" "object cache flush" cache flush || return 1
    step_say "$idx" "$env" "clearing the edge cache"
    if ! with_pulse workflow $terminus env:clear-cache "$site.$env"; then
      step_fail "$idx" "$env" "env:clear-cache failed — stopping"
      return 1
    fi

    step_ok "$idx" "$env" "done"
  fi
}

##
# Run one WP-CLI command on the environment and insist it actually ran.
#
# ⚠ Exit 0 is not enough. `terminus wp` can exit 0 and print nothing at all,
# when the site's composer installed the WP-CLI framework without its command
# bundle, or when wp-config.php reads $_SERVER unguarded under CLI. A missing
# command and a completed one are then indistinguishable. Both of these
# commands print a "Success:" line on every real run, including "already at
# latest" and "No updates required", so no Success line means it didn't run.
##
wp_step () {
  local idx=$1 env=$2 label=$3
  shift 3
  local out

  step_say "$idx" "$env" "$label"
  out=$($terminus wp "$site.$env" -- "$@" 2>&1)
  local rc=$?
  echo "$out" | grep -v 'Object Cache Pro'

  if [[ $rc -ne 0 || $out != *Success:* ]]; then
    step_fail "$idx" "$env" "$label did not report success — stopping before anything reaches the next environment (check: terminus wp $site.$env -- help --skip-plugins)"
    return 1
  fi
}

##
# Blocks until the pushed-to environment's code log shows the commit that was
# pushed: dev's for master, or a multidev's for its own branch, which Pantheon
# always names after the environment.
#
# ⚠ Seen on ar-md, 2026-09-29: run straight after a push, the sync check found
# nothing in flight — Pantheon had not yet created the build for the push —
# declared dev ready, and env:deploy promoted dev's PREVIOUS commit to test and
# live. Every step reported success. The code log records a pushed commit the
# moment it lands, before the build starts, so waiting for it closes that
# window; terminus_sync_check then waits out the build itself.
#
# "What was pushed" is the remote-tracking ref of the Pantheon remote, never
# local HEAD: unpushed local commits would otherwise wait forever. The remote
# is found by the site's id in its URL, so a repo that is not this site's —
# or no repo at all — skips the check and deploys exactly as before.
#
# ⚠ Reads the repo in the working directory, where the launcher was run from.
# That only holds because launcher.sh sources its includes by absolute path:
# it used to cd into its own directory for each one, and the first real run of
# this check read the LAUNCHER's repo — whose remote never names the site —
# and silently skipped itself.
##
terminus_commit_check () {
  local want=$1
  local idx=$2
  local uuid remote pushed deployed waited=0 limit=900 delay=15
  local codeenv=dev branch=master
  if [[ $multi == true ]]; then
    codeenv=$want
    branch=$want
  fi

  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  uuid=$($terminus site:info $site --field=id 2>/dev/null)
  [[ -n $uuid ]] || return 0
  remote=$(git remote -v | awk -v u="$uuid" 'index($2, u) && $3 == "(push)" { print $1; exit }')
  [[ -n $remote ]] || return 0
  pushed=$(git rev-parse --verify --quiet "refs/remotes/$remote/$branch")
  [[ -n $pushed ]] || return 0

  deploy_phase "$idx" "$want" "waiting for ${pushed:0:8} to reach $codeenv"
  until [[ $deployed == $pushed ]];
    do
      deployed=$($terminus env:code-log $site.$codeenv --fields=hash --format=string 2>/dev/null | head -1)
      [[ -n $deployed ]] && deploy_beat
      [[ $deployed == $pushed ]] && break
      if (( waited >= limit )); then
        step_fail "$idx" "$want" "$codeenv never showed ${pushed:0:8} (newest is ${deployed:0:8}) — stopping, nothing promoted"
        return 1
      fi
      echo "   [$idx/$count] $want — waiting for ${pushed:0:8} to reach $codeenv (newest is ${deployed:0:8}); retry in ${delay}s"
      sleep $delay
      (( waited += delay ))
    done
  step_say "$idx" "$want" "$codeenv has ${pushed:0:8}"
}

##
# Blocks while any workflow is still in flight on the site.
#
# ⚠ The old check accepted any 'succeeded' on the SITE, and 'backup'
# explicitly. Both are the same mistake: a nightly backup, a file clone or
# another environment's sync satisfies it, so it could green-light a deploy
# that had nothing to do with the code just pushed.
#
# ⚠ Matching the workflow's env to the target is NOT the fix, though it looks
# like it. `l t.<site>.dev` with no fresh push is a legitimate re-run, and the
# newest workflow then belongs to whatever ran last — often another
# environment entirely — so an env match waits forever. Tested against this
# very repo after a live deploy, where it hung.
#
# What the wait is actually for is not colliding with work already running, so
# that is what it tests: in flight -> wait, failed -> stop, otherwise proceed.
#
# Between `git push` and Pantheon creating the sync_code workflow there is a
# window where nothing is running and this returns immediately — closed by
# terminus_commit_check, which runs first.
##
terminus_sync_check () {
  local want=$1
  local idx=$2
  local line wenv wname wstatus inflight waiting_on
  ready=false
  delay=24

  until [[ $ready == true ]];
    do
      # One call, three fields, tab separated — rather than three calls, which
      # would triple the API rate-limit cost of every poll.
      # $terminus, not a bare `terminus` — the binary is configurable in
      # your.launcher.settings, and this was the one call ignoring it.
      line=$($terminus workflow:info:status $site --fields=env,workflow,status --format=string 2>/dev/null | tail -1)
      wenv=$(echo "$line" | cut -f1)
      wname=$(echo "$line" | cut -f2)
      wstatus=$(echo "$line" | cut -f3)

      if [[ $wstatus == *failed* ]]; then
        step_fail "$idx" "$want" "${wname:-workflow} failed on ${wenv:-the site} — stopping, the code never landed"
        return 1
      fi

      # The newest workflow is not the only one that can be in flight. A
      # pantheon.yml database bump starts "Change database version" and then a
      # Converge that finishes first, so the newest reads succeeded while the
      # DB change is still running — and a drush deploy inside it dies
      # mid-cim on a misleading ConsoleErrorEvent fatal (mspairport,
      # 2026-10-20). Scan the recent list for anything still in flight.
      inflight=$($terminus workflow:list $site --fields=env,workflow,status --format=tsv 2>/dev/null \
        | awk -F'\t' '$3 ~ /running|queued|started/ { print; exit }')
      if [[ -n $inflight ]]; then
        wenv=$(echo "$inflight" | cut -f1)
        wname=$(echo "$inflight" | cut -f2)
        wstatus=$(echo "$inflight" | cut -f3)
      fi

      [[ -n $line ]] && deploy_beat

      if [[ $wstatus == *running* || $wstatus == *queued* || $wstatus == *started* ]]; then
        if [[ $wname != $waiting_on ]]; then
          waiting_on=$wname
          deploy_phase "$idx" "$want" "waiting on ${wname:-workflow}"
        fi
        check_site
        echo "   [$idx/$count] $want — waiting on ${wname:-workflow} (${wstatus}${wenv:+ on $wenv}); retry in ${delay}s"
        sleep $delay
      else
        ready=true
        check_site
        step_ok "$idx" "$want" "nothing in flight, code is on $want"
      fi
    done
}

# Check that terminus command exists.
if type $terminus >/dev/null 2>&1; then
  if [[ $terminusValue ]]; then
    declare steps=('dev' 'test' 'live')
    site=${terminusValue%.*}
    env=${terminusValue#*.}
    multi=false

    if [[ $site && $env ]]; then
      case $env in
        'dev')
          count=1
          ;;
        'test')
          count=2
          ;;
        'live')
          count=3
          ;;
        'php')
          $terminus env:info $site.live | grep 'PHP Version'
          exit 0
          ;;
        *)
          echo
          echo 'Attempting to run against multidev.'
          echo
          multidev=$env
          multi=true
          count=1
      esac

      # Top level, not in a function: zsh fires a function's EXIT trap when
      # the function returns, which would delete this mid-deploy. INT/TERM
      # are routed through exit so a Ctrl-C cleans up too.
      deploy_state_file=$deploy_state_dir/$site
      mkdir -p "$deploy_state_dir"
      trap 'rm -f "$deploy_state_file" "$deploy_state_file".tmp.*(N)' EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM

      i=1
      if [[ $multi != true ]]; then
        while [[ $i -le $count ]]
        do
          # ⚠ break, not continue. The whole point of checking the status is
          # that a failure upstream must not reach the environment downstream.
          if ! terminus_loop "$i" "${steps[$i]}" "$multi"; then
            echo
            echo "Deploy stopped at ${steps[$i]}. Environments after it were left untouched."
            echo
            exit 1
          fi
          ((i++))
        done
        echo
        echo "✓  Deploy complete: ${steps[1]}$([[ $count -ge 2 ]] && echo " → ${steps[2]}")$([[ $count -ge 3 ]] && echo " → ${steps[3]}")"
        echo
      else
        terminus_loop "$i" "$multidev" "$multi" || exit 1
      fi
    fi
  fi
fi
